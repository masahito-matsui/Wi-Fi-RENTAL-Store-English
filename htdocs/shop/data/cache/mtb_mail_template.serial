a:20:{i:1;s:23:"1.注文受付メール";i:2;s:14:"2.住所不備";i:3;s:17:"3.キャンセル";i:4;s:38:"4.午前中は8時～12時ですよ！";i:5;s:40:"5.発送メール(羽田・成田直通)";i:6;s:41:"6.通信容量追加完了のお知らせ";i:7;s:17:"7.延長メール";i:8;s:50:"8.発送メール（ゆうパック＆ヤマト）";i:9;s:23:"9.通信停止の連絡";i:10;s:15:"10.返却完了";i:11;s:33:"11.日時間に合わない場合";i:12;s:18:"12.代替品送付";i:13;s:24:"13.伝達メッセージ";i:14;s:33:"14.注文内容変更のご連絡";i:15;s:36:"15.会員登録完了のお知らせ";i:16;s:39:"16.延滞の為の延長依頼メール";i:17;s:24:"17.延滞料金発生！";i:18;s:30:"18.返却品の不足あり★";i:19;s:30:"19.返却についての確認";i:20;s:51:"20.不明端末：　紛失・延滞代金ご請求";}